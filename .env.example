TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram user ID — only this user can run privileged bot commands
# (/auth, /chats, /read, /watch, /export, /setmodel, /setkey, /seturl).
# Leave blank to allow anyone (not recommended for production).
# Find your user ID by sending /myid to your bot.
TELEGRAM_OWNER_ID=

# Private Telegram chat/channel that the bot uses as a message archive.
# The bot must be an admin of this chat.
# Get the chat ID by adding @userinfobot to the chat, or use a negative group ID.
TELEGRAM_STORAGE_CHAT_ID=-1002040670517

# ── MTProto user-account credentials ──────────────────────────────────────
#
# Required for Tasks 1–3 (reading private groups, watching for deletion,
# exporting chat history including books and photos).
#
# 1. Go to https://my.telegram.org/apps
# 2. Log in with your phone number
# 3. Create a new application (any name/platform)
# 4. Copy the "App api_id" and "App api_hash" below
#
# After filling these in, send /auth <your_phone> to the bot to authenticate.
# Your session will be saved to `data.session` — you only need to do this once.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# LLM provider — the three variables below MUST all belong to the same provider.
#
#   Provider     | LLM_API_URL                                        | LLM_API_KEY           | LLM_MODEL example
#   -------------|----------------------------------------------------|-----------------------|----------------------------------
#   OpenRouter   | https://openrouter.ai/api/v1/chat/completions      | sk-or-v1-...          | mistralai/mistral-7b-instruct:free
#   OpenAI       | https://api.openai.com/v1/chat/completions         | sk-...                | gpt-4o-mini
#   Ollama(local)| http://localhost:11434/v1/chat/completions         | ollama                | llama3
#
# Using an OpenRouter key with the OpenAI URL (or vice-versa) will fail with a 401 error.
#
# Rotating / revoking your API key?
#   → Only update LLM_API_KEY with your new key.
#   → LLM_API_URL and LLM_MODEL do NOT change — they are tied to the provider and
#     the model you chose, not to any specific key.
#
# You can also update model/key/url at runtime without restarting via bot commands:
#   /setmodel <model>  /setkey <key>  /seturl <url>  /llminfo
LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
LLM_API_KEY=your_openrouter_api_key_here
# Model must be a slug offered by the provider set in LLM_API_URL above.
# OpenRouter free models: https://openrouter.ai/models?q=free
LLM_MODEL=mistralai/mistral-7b-instruct:free

# How many recent messages to include as context for each LLM call (default: 10)
LLM_CONTEXT_MESSAGES=10

# Google Calendar (Phase 9 — optional, leave blank until implemented)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

