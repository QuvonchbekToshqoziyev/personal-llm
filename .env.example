TELEGRAM_BOT_TOKEN=your_bot_token_here

# Private Telegram chat/channel that the bot uses as a message archive.
# The bot must be an admin of this chat.
# Get the chat ID by adding @userinfobot to the chat, or use a negative group ID.
TELEGRAM_STORAGE_CHAT_ID=

# LLM — OpenRouter (https://openrouter.ai)
# Endpoint is OpenAI-compatible; swap LLM_API_URL for any other provider if needed.
LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
LLM_API_KEY=your_openrouter_api_key_here
# Free model available on OpenRouter — change to any model slug from openrouter.ai/models
LLM_MODEL=mistralai/mistral-7b-instruct:free

# How many recent messages to include as context for each LLM call (default: 10)
LLM_CONTEXT_MESSAGES=10

# Google Calendar (Phase 9 — optional, leave blank until implemented)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
